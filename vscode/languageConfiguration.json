{
    "comments": {
        "shebang"     : "#!",
        "lineComment" : "\\",
        "stackEffect" : ["(", ")"]
    },
    "brackets": [
        [":", ";"],
        ["[", "]"],
        ["(", ")"]
    ],
    "autoClosingPairs": [
        [":", ";"],
        ["[", "]"],
        ["(", ")"],
        {"open": "\"", "close": "\"", "notIn": [ "string"            ]},
    ]
    "surroundingPairs": [
        [":", ";"],
        ["[", "]"],
        ["(", ")"],
        [ "\"", "\"" ],
        [ "'" , "'"  ]
    ]
}
